<Window x:Class="Autoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoverseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="start" Content="Start" Width="90" Height="45" Grid.Row="1" Background="CornflowerBlue" Click="start_Click" />
        <Canvas x:Name="palya" Background="AliceBlue" Grid.Row="3">
            <Button x:Name="auto" Content="Auto" Width="90" Height="45" Background="ForestGreen" Canvas.Left="20" Canvas.Top="50" />
            <Button x:Name="auto2" Content="Auto2" Width="90" Height="45" Background="Gainsboro" Canvas.Left="20" Canvas.Top="120" />
            <Button x:Name="auto3" Content="Auto3" Width="90" Height="45" Background="BlanchedAlmond" Canvas.Left="20" Canvas.Top="190" />
            <TextBox Height="334" Canvas.Right="0" Width="51" Background="Beige"/>

        </Canvas>

    </Grid>
</Window>
